	<parameter name="TANGGAL_LAPORAN" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    hsa.peringkat,
    k.kode_karyawan,
    k.nama_lengkap,
    hsa.nilai_total_spk,
    hsa.tanggal_perhitungan
FROM
    hasil_seleksi_akhir hsa
JOIN
    karyawan k ON hsa.karyawan_id = k.karyawan_id
ORDER BY
    hsa.peringkat ASC, hsa.nilai_total_spk DESC;]]>
	</queryString>
	<field name="peringkat" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="kode_karyawan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_lengkap" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nilai_total_spk" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tanggal_perhitungan" class="java.sql.Timestamp">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
